INFERENCE_PROVIDER=opencode_go
INFERENCE_MODEL=
OPENCODE_GO_API_KEY=
GATEWAY_URL=http://127.0.0.1:7003
OBSERVER_URL=http://127.0.0.1:7001
BRAIN_URL=http://127.0.0.1:7002
# observer: Prometheus (port-forward svc/prometheus 9090) and reader kubeconfig from scripts/make_kubeconfigs.sh
PROMETHEUS_URL=http://127.0.0.1:9090
READER_KUBECONFIG=reader.kubeconfig
# brain: Jaeger UI base through frontend-proxy (port-forward svc/frontend-proxy 8080)
JAEGER_URL=http://127.0.0.1:8080/jaeger/ui
CHAOS_URL=http://127.0.0.1:7004
DISCORD_BOT_TOKEN=
DISCORD_FYI_CHANNEL_ID=
DISCORD_WAKE_CHANNEL_ID=
DISCORD_TICKETS_CHANNEL_ID=
DISCORD_ONCALL_ROLE_ID=
APPROVAL_EXPIRY_SECONDS=300
REPAGE_SECONDS=120
ONCALL_REHEARSAL=0
# comma-separated Discord user ids allowed to approve actions (config/policy.yaml approval.approvers_env)
ONCALL_APPROVER_IDS=
